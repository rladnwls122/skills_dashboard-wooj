{
  "name": "skills-dashboard",
  "version": "1.0.0",
  "private": true,
  "license": "BSD-3-Clause",
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "dev": "vite --host 127.0.0.1 --port 3100",
    "build": "vite build",
    "build:clean": "pnpm clean && pnpm build",
    "start": "vite preview --host 127.0.0.1 --port 3100",
    "typecheck": "tsc --noEmit",
    "test": "pnpm test:ddos && pnpm test:applog && pnpm test:threatsig && pnpm test:ruleassemble && pnpm test:window && pnpm test:waflogagg && pnpm test:metricsummary && pnpm test:grading && pnpm test:probe && pnpm test:reshistory && pnpm test:charttip && pnpm test:nodecount && pnpm test:wafcountevidence && pnpm test:awscreds",
    "test:awscreds": "node --import ./scripts/testing/register.mjs scripts/awscreds.test.mjs",
    "test:nodecount": "node --import ./scripts/testing/register.mjs scripts/nodecount.test.mjs",
    "test:wafcountevidence": "node --import ./scripts/testing/register.mjs scripts/wafcountevidence.test.mjs",
    "test:charttip": "node --import ./scripts/testing/register.mjs scripts/charttip.test.mjs",
    "test:reshistory": "node --import ./scripts/testing/register.mjs scripts/reshistory.test.mjs",
    "test:probe": "node --import ./scripts/testing/register.mjs scripts/probe.test.mjs",
    "test:ruleassemble": "node --import ./scripts/testing/register.mjs scripts/ruleassemble.test.mjs",
    "test:ddos": "node --import ./scripts/testing/register.mjs scripts/ddos-policy.test.mjs",
    "test:applog": "node --import ./scripts/testing/register.mjs scripts/applogquery.test.mjs",
    "test:threatsig": "node --import ./scripts/testing/register.mjs scripts/threatsig.test.mjs",
    "test:window": "node --import ./scripts/testing/register.mjs scripts/window.test.mjs",
    "test:waflogagg": "node --import ./scripts/testing/register.mjs scripts/waflogagg.test.mjs",
    "test:metricsummary": "node --import ./scripts/testing/register.mjs scripts/metricsummary.test.mjs",
    "test:grading": "node --import ./scripts/testing/register.mjs scripts/grading.test.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 3100"
  },
  "dependencies": {
    "@aws-sdk/client-cloudtrail": "^3.1108.0",
    "@aws-sdk/client-cloudwatch": "^3.716.0",
    "@aws-sdk/client-cloudwatch-logs": "^3.716.0",
    "@aws-sdk/client-ec2": "^3.1108.0",
    "@aws-sdk/client-eks": "^3.716.0",
    "@aws-sdk/client-elastic-load-balancing-v2": "^3.716.0",
    "@aws-sdk/client-wafv2": "^3.716.0",
    "@kubernetes/client-node": "^1.3.0",
    "better-sqlite3": "^12.2.0",
    "next": "^15.4.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "uplot": "^1.6.32"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.11",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.0.5",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.8.3",
    "vite": "^8.2.1"
  }
}
