{
  "name": "skills-dashboard",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\"",
    "dev": "next dev -p 3100 -H 127.0.0.1",
    "build": "next build",
    "build:clean": "pnpm clean && pnpm build",
    "start": "next start -p 3100 -H 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "pnpm test:ddos && pnpm test:applog && pnpm test:rulestatement && pnpm test:rulesim && pnpm test:threatsig && pnpm test:gateway && pnpm test:ruleassemble && pnpm test:window && pnpm test:waflogagg && pnpm test:metricsummary && pnpm test:grading && pnpm test:probe && pnpm test:reshistory",
    "test:reshistory": "node --import ./scripts/testing/register.mjs scripts/reshistory.test.mjs",
    "test:probe": "node --import ./scripts/testing/register.mjs scripts/probe.test.mjs",
    "test:ruleassemble": "node --import ./scripts/testing/register.mjs scripts/ruleassemble.test.mjs",
    "test:ddos": "node --import ./scripts/testing/register.mjs scripts/ddos-policy.test.mjs",
    "test:applog": "node --import ./scripts/testing/register.mjs scripts/applogquery.test.mjs",
    "test:rulestatement": "node --import ./scripts/testing/register.mjs scripts/rulestatement.test.mjs",
    "test:rulesim": "node --import ./scripts/testing/register.mjs scripts/rulesim.test.mjs",
    "test:threatsig": "node --import ./scripts/testing/register.mjs scripts/threatsig.test.mjs",
    "test:gateway": "node --import ./scripts/testing/register.mjs scripts/gateway.test.mjs",
    "test:window": "node --import ./scripts/testing/register.mjs scripts/window.test.mjs",
    "test:waflogagg": "node --import ./scripts/testing/register.mjs scripts/waflogagg.test.mjs",
    "test:metricsummary": "node --import ./scripts/testing/register.mjs scripts/metricsummary.test.mjs",
    "test:grading": "node --import ./scripts/testing/register.mjs scripts/grading.test.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch": "^3.716.0",
    "@aws-sdk/client-cloudwatch-logs": "^3.716.0",
    "@aws-sdk/client-eks": "^3.716.0",
    "@aws-sdk/client-elastic-load-balancing-v2": "^3.716.0",
    "@aws-sdk/client-wafv2": "^3.716.0",
    "@kubernetes/client-node": "^1.3.0",
    "better-sqlite3": "^12.2.0",
    "next": "^15.4.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "uplot": "^1.6.32"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.11",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.8.3"
  }
}
