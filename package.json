{
  "name": "skills-dashboard",
  "version": "1.0.0",
  "private": true,
  "license": "BSD-3-Clause",
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true}); try { require('fs').unlinkSync('api.exe'); } catch(e){} try { require('fs').unlinkSync('api'); } catch(e){}\"",
    "build:frontend": "vite build",
    "build:backend": "go build -C backend -o ../api.exe .",
    "build": "pnpm build:frontend && pnpm build:backend",
    "build:clean": "pnpm clean && pnpm build",
    "dev:frontend": "vite",
    "dev:backend": "go run -C backend .",
    "dev": "node scripts/start.mjs --dev",
    "start:frontend": "vite preview",
    "start:backend": "node scripts/run-backend.mjs",
    "start": "node scripts/start.mjs",
    "typecheck": "tsc --noEmit",
    "test:contracts": "node scripts/shared-types.test.mjs && node scripts/dashboard-api-contract.test.mjs",
    "test": "pnpm typecheck && pnpm test:contracts"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "uplot": "^1.6.32"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.11",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^10.0.4",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.8.3",
    "vite": "^8.2.1"
  }
}
