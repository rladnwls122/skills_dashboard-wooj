# AWS credentials (dev). In-cluster: use IRSA or node role instead.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-northeast-2

# WAF: skills-waf is attached to CloudFront -> scope CLOUDFRONT (WAF API region us-east-1)
WAF_SCOPE=CLOUDFRONT
WAF_WEB_ACL_NAME=skills-waf

# Resource names. Empty values fall back to auto-discovery.
ALB_NAME=skills-alb
RDS_PROXY_NAME=skills-db-proxy
EKS_CLUSTER_NAME=skills-eks

# Optional: WAF full logs (CloudWatch Logs group, e.g. aws-waf-logs-skills).
# When set, detailed status-code distribution uses Logs Insights.
WAF_LOG_GROUP=

# Kubernetes
TARGET_NAMESPACE=default
MAX_REPLICAS=20

# SQLite path (in-cluster: emptyDir mount). Shared by the Go backend and the
# legacy Next.js server modules — same schema, same file.
DB_PATH=./data/dashboard.db

# --- Go backend (backend/) ---------------------------------------------------
# The backend reads these from the process environment; it does not parse this
# file. Export them, or use a launcher that does (mise, direnv, dotenv-cli).

# Where the API listens. Loopback by default: it holds AWS credentials.
API_ADDR=127.0.0.1:8787

# Browsers that may call the API. Comma-separated, exact origins.
CORS_ALLOW_ORIGINS=http://localhost:3100,http://127.0.0.1:3100

# Where the UI sends its calls. Inlined at build time by Next.js.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8787
