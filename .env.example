# 대시보드 설정 파일 예시.
#
# 사용법: 이 파일을 .env 로 복사하고 필요한 값만 채우면 됩니다.
#
#   cp .env.example .env        (Windows PowerShell: copy .env.example .env)
#
# 백엔드와 실행 스크립트가 시작할 때 .env 를 직접 읽습니다. mise·direnv·
# dotenv-cli 같은 런처가 없어도 됩니다. Go 릴리스 바이너리는 실행 파일이 있는
# 폴더의 .env 도 함께 찾습니다.
#
# 우선순위 (뒤로 갈수록 강함):
#   .env  <  실제 환경변수  <  대시보드 설정(설정 화면 → SQLite)
# 즉 값이 비어 있으면 무시되고, 이미 export 된 환경변수는 이 파일이 덮지
# 않습니다. 다른 위치의 파일을 쓰려면 ENV_FILE=경로 로 지정하세요.
#
# .env 는 .gitignore 에 있습니다 — 자격 증명을 커밋하지 마세요.

# --- AWS ---------------------------------------------------------------------
# 비워 두는 것이 정상입니다. 대시보드 설정 화면이 로컬 `aws` CLI 세션을
# (AWS_SESSION_TOKEN 포함) 재시작 없이 주입하며, 임시 키가 경기 중 만료돼도
# 살아남는 유일한 경로입니다. 이 파일은 시작할 때 한 번만 읽습니다.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# 임시(ASIA…) 키를 여기에 고정할 때만 필요합니다.
AWS_SESSION_TOKEN=
AWS_REGION=ap-northeast-2

# --- WAF ---------------------------------------------------------------------
# CLOUDFRONT scope 인 WebACL 은 us-east-1 에서만 조회됩니다 (자동 전환).
# ALB 에 직접 붙였다면 REGIONAL 로 바꾸세요.
WAF_SCOPE=CLOUDFRONT
WAF_WEB_ACL_NAME=skills-waf

# 선택: WAF 전체 로그 그룹 (예: aws-waf-logs-skills).
# 지정하면 상태코드 분포와 User-Agent 통계를 Logs Insights 로 전수 집계합니다.
# 비우면 GetSampledRequests(규칙당 500건)로 떨어집니다.
WAF_LOG_GROUP=

# --- 리소스 이름 --------------------------------------------------------------
# 비우면 자동 탐색합니다.
ALB_NAME=skills-alb
RDS_PROXY_NAME=skills-db-proxy
EKS_CLUSTER_NAME=skills-eks

# 앱의 [GIN] 액세스 로그가 들어가는 CloudWatch Logs 그룹.
# EKS Container Insights: /aws/containerinsights/<클러스터>/application
# 그룹이 여러 개면 쉼표로 나열하세요.
# APP_LOG_GROUP=/aws/containerinsights/skills-eks/application

# 채점 대상 API 경로와 과제가 허용하는 EC2 타입. 아래가 기본값입니다.
# APP_TRAFFIC_PATHS=/v1/user,/v1/product,/v1/stress,/images
# ALLOWED_INSTANCE_TYPE=t3.medium

# --- Kubernetes ---------------------------------------------------------------
TARGET_NAMESPACE=default
MAX_REPLICAS=20

# --- 프로세스 ------------------------------------------------------------------
# SQLite 파일. Node 백엔드와 Go 백엔드가 같은 스키마·같은 파일을 씁니다.
DB_PATH=./data/dashboard.db

# API 가 열리는 주소. 기본은 루프백입니다 — AWS 자격 증명을 들고 있으므로
# 0.0.0.0 바인딩은 의도적으로만 하세요.
API_ADDR=127.0.0.1:8787

# API 를 호출할 수 있는 브라우저 origin. 쉼표로 구분한 정확한 origin.
CORS_ALLOW_ORIGINS=http://localhost:3100,http://127.0.0.1:3100

# 프런트엔드 개발 서버 포트와, 그 서버가 /api 를 넘길 대상.
PORT=3100
API_PROXY_TARGET=http://127.0.0.1:8787

# 선택: UI 가 절대 주소로 API 를 호출하게 합니다. 비우면 개발 서버의 /api
# 프록시(같은 origin)를 씁니다 — 보통 비워 두는 쪽이 안전합니다.
VITE_API_BASE_URL=
